---
type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<div class="contents" data-post-stats data-stats-slug={slug}>
  <div
    class="inline-flex items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 backdrop-blur-sm"
    aria-label="文章浏览量"
    title="文章浏览量"
  >
    <svg
      class="size-3.5 text-accent/70"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <span class="text-sm opacity-70" data-view-count aria-live="polite">--</span
    >
  </div>

  <button
    type="button"
    class="post-like-button inline-flex items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 text-foreground/70 backdrop-blur-sm transition-all duration-200 disabled:cursor-wait disabled:opacity-50"
    data-like-button
    aria-label="为文章点赞"
    aria-pressed="false"
    title="正在加载点赞状态"
    disabled
  >
    <svg
      class="size-3.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 10v12"></path>
      <path
        d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"
      ></path>
    </svg>
    <span class="text-sm" data-like-count aria-live="polite">--</span>
  </button>
</div>

<script>
  const VISITOR_KEY = "lucky:visitor-id";

  type StatsResponse = {
    views: number;
    likes: number;
    liked: boolean;
  };

  type StatsWindow = Window & {
    luckyPostStatsPageLoadBound?: boolean;
  };

  function getVisitorId() {
    let visitorId = localStorage.getItem(VISITOR_KEY);
    if (!visitorId) {
      visitorId = crypto.randomUUID();
      localStorage.setItem(VISITOR_KEY, visitorId);
    }
    return visitorId;
  }

  async function requestStats(
    url: string,
    options?: RequestInit
  ): Promise<StatsResponse> {
    const response = await fetch(url, {
      ...options,
      headers: {
        "Content-Type": "application/json",
        ...options?.headers,
      },
    });

    if (!response.ok)
      throw new Error(`Stats request failed: ${response.status}`);
    return response.json() as Promise<StatsResponse>;
  }

  function renderStats(root: HTMLElement, stats: StatsResponse) {
    const viewCount = root.querySelector<HTMLElement>("[data-view-count]");
    const likeCount = root.querySelector<HTMLElement>("[data-like-count]");
    const likeButton =
      root.querySelector<HTMLButtonElement>("[data-like-button]");

    if (viewCount) viewCount.textContent = String(stats.views);
    if (likeCount) likeCount.textContent = String(stats.likes);
    if (!likeButton) return;

    likeButton.setAttribute("aria-pressed", String(stats.liked));
    likeButton.setAttribute(
      "aria-label",
      stats.liked ? "取消文章点赞" : "为文章点赞"
    );
    likeButton.title = stats.liked ? "取消点赞" : "点赞";
  }

  async function initPostStats(root: HTMLElement) {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const slug = root.dataset.statsSlug;
    const likeButton =
      root.querySelector<HTMLButtonElement>("[data-like-button]");
    if (!slug || !likeButton) return;

    let visitorId: string;
    let currentStats: StatsResponse;

    try {
      visitorId = getVisitorId();
      currentStats = await requestStats(
        `/api/stats?slug=${encodeURIComponent(slug)}&visitorId=${encodeURIComponent(visitorId)}`
      );
      renderStats(root, currentStats);

      currentStats = await requestStats("/api/view", {
        method: "POST",
        body: JSON.stringify({ slug, visitorId }),
      });
      renderStats(root, currentStats);
      likeButton.disabled = false;
    } catch {
      likeButton.disabled = true;
      likeButton.title = "统计服务暂不可用";
      return;
    }

    likeButton.addEventListener(
      "click",
      async () => {
        const previousStats = currentStats;
        likeButton.disabled = true;
        likeButton.dataset.loading = "true";

        try {
          currentStats = await requestStats("/api/like", {
            method: "POST",
            body: JSON.stringify({
              slug,
              visitorId,
              liked: !previousStats.liked,
            }),
          });
          renderStats(root, currentStats);

          if (currentStats.liked && !previousStats.liked) {
            likeButton.classList.remove("stats-like-pop");
            requestAnimationFrame(() =>
              likeButton.classList.add("stats-like-pop")
            );
          }
        } catch {
          currentStats = previousStats;
          renderStats(root, previousStats);
        } finally {
          likeButton.disabled = false;
          delete likeButton.dataset.loading;
        }
      },
      { once: false }
    );
  }

  function initAllPostStats() {
    document
      .querySelectorAll<HTMLElement>("[data-post-stats]")
      .forEach(root => void initPostStats(root));
  }

  const statsWindow = window as StatsWindow;
  if (!statsWindow.luckyPostStatsPageLoadBound) {
    document.addEventListener("astro:page-load", initAllPostStats);
    statsWindow.luckyPostStatsPageLoadBound = true;
  }
  initAllPostStats();
</script>

<style>
  .post-like-button[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .post-like-button.stats-like-pop svg {
    animation: stats-like-pop 220ms ease-out;
  }

  @keyframes stats-like-pop {
    50% {
      transform: scale(1.16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-like-button.stats-like-pop svg {
      animation: none;
    }
  }
</style>
