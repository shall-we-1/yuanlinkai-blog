---
import type { CollectionEntry } from "astro:content";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";
import { buildPublishingHeatmap } from "@/utils/publishingHeatmap";

type Props = { posts: CollectionEntry<"blog">[] };
const { posts } = Astro.props;
const years = buildPublishingHeatmap(
  posts.map(post => ({
    pubDatetime: post.data.pubDatetime,
    timezone: post.data.timezone,
    path: getPath(post.id, post.filePath),
  })),
  SITE.timezone
);
---

<section class="mt-12" aria-labelledby="publishing-title">
  <h2 id="publishing-title" class="text-lg font-semibold">发布足迹</h2>
  <p class="mt-2 text-sm text-foreground/60">每一格，记下一天的文章发布。</p>

  {
    years.length === 0 ? (
      <p class="mt-6 text-sm text-foreground/60">还没有发布文章。</p>
    ) : (
      years.map(({ year, months, cells, postCount, weeks }) => (
        <div class="mt-6 rounded-2xl border border-border/20 bg-muted/5 px-4 py-5 backdrop-blur-sm sm:px-6">
          <div class="mb-4 flex items-baseline gap-3">
            <h3
              id={`publishing-${year}`}
              class="font-firacode text-sm font-medium"
            >
              {year}
            </h3>
            <span class="text-xs text-foreground/50">{postCount} 篇</span>
          </div>
          <div
            class="heatmap-scroll overflow-x-auto pb-2"
            role="region"
            aria-labelledby={`publishing-${year}`}
            tabindex="0"
          >
            <div class="heatmap-calendar" style={`--weeks:${weeks}`}>
              <div class="heatmap-months" aria-hidden="true">
                {months.map(month => (
                  <span style={`grid-column:${month.column}`}>
                    {month.label}
                  </span>
                ))}
              </div>
              <div class="heatmap-weekdays" aria-hidden="true">
                {["一", "", "三", "", "五", "", "日"].map(day => (
                  <span>{day}</span>
                ))}
              </div>
              <div class="heatmap-days">
                {cells.map(day =>
                  day ? (
                    day.href ? (
                      <a
                        class="heatmap-cell"
                        data-level={day.level}
                        data-date={day.date}
                        href={day.href}
                        title={day.title}
                        aria-label={day.title}
                      />
                    ) : (
                      <span
                        class="heatmap-cell"
                        data-level={day.level}
                        data-date={day.date}
                        title={day.title}
                        aria-label={day.title}
                        role="img"
                      />
                    )
                  ) : (
                    <span aria-hidden="true" />
                  )
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    )
  }
  {
    years.length > 0 && (
      <div
        class="mt-3 flex flex-wrap justify-end gap-x-4 gap-y-2 text-xs text-foreground/55"
        aria-label="每日发布篇数图例"
      >
        {["0 篇", "1 篇", "2 篇", "3 篇及以上"].map((label, level) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="heatmap-cell" data-level={level} aria-hidden="true" />
            {label}
          </span>
        ))}
      </div>
    )
  }
</section>

<style>
  .heatmap-calendar {
    display: grid;
    grid-template-columns: 20px auto;
    grid-template-rows: 20px auto;
    gap: 4px;
    width: max-content;
    padding: 3px;
  }

  .heatmap-months {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(var(--weeks), 11px);
    gap: 3px;
    font-size: 10px;
    color: color-mix(in srgb, var(--foreground) 60%, transparent);
    white-space: nowrap;
  }

  .heatmap-weekdays {
    display: grid;
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
    font-size: 10px;
    line-height: 11px;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .heatmap-days {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 11px);
    grid-template-columns: repeat(var(--weeks), 11px);
    gap: 3px;
  }

  .heatmap-cell {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--foreground) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 18%, transparent);
    transition:
      transform 150ms ease,
      box-shadow 150ms ease;
  }

  .heatmap-cell[data-level="1"] {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .heatmap-cell[data-level="2"] {
    background: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .heatmap-cell[data-level="3"] {
    background: color-mix(in srgb, var(--accent) 90%, transparent);
  }

  .heatmap-days .heatmap-cell:is(:hover, :focus-visible) {
    transform: scale(1.1);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .heatmap-cell {
      transition: none;
    }
    .heatmap-days .heatmap-cell:is(:hover, :focus-visible) {
      transform: none;
    }
  }
</style>
