---

---

<div class="canvas-nest-background" data-canvas-nest aria-hidden="true"></div>

<script>
  import CanvasNest from "canvas-nest.js";

  type CanvasNestWindow = Window & {
    canvasNestInstance?: CanvasNest;
    canvasNestMediaCleanup?: () => void;
    canvasNestPointerCleanup?: () => void;
  };

  const canvasWindow = window as CanvasNestWindow;
  const disabledMediaQuery =
    "(max-width: 768px), (prefers-reduced-motion: reduce)";

  function destroyCanvasNest() {
    canvasWindow.canvasNestPointerCleanup?.();
    canvasWindow.canvasNestPointerCleanup = undefined;

    // The library restores global mouse handlers on destroy. They are not ours:
    // preserve the current handlers, including any installed since initialization.
    const mouseMove = window.onmousemove;
    const mouseOut = window.onmouseout;
    canvasWindow.canvasNestInstance?.destroy();
    window.onmousemove = mouseMove;
    window.onmouseout = mouseOut;
    canvasWindow.canvasNestInstance = undefined;

    document
      .querySelectorAll("[data-canvas-nest] canvas")
      .forEach(canvas => canvas.remove());
  }

  function syncCanvasNest(mediaQuery: MediaQueryList) {
    destroyCanvasNest();

    const container = document.querySelector<HTMLElement>("[data-canvas-nest]");
    if (!container || mediaQuery.matches) return;

    const config = {
      color: "0,0,255",
      pointColor: "0,0,255",
      opacity: 0.7,
      count: 99,
      zIndex: 0,
    };

    const mouseMove = window.onmousemove;
    const mouseOut = window.onmouseout;
    const instance = new CanvasNest(container, config);
    canvasWindow.canvasNestInstance = instance;

    // canvas-nest assumes document coordinates and adds scrollTop to clientY.
    // Our canvas is fixed to the viewport. Replace only its pointer handling;
    // retain the library's drawing loop and resize sensor.
    window.onmousemove = mouseMove;
    window.onmouseout = mouseOut;
    const pointerEvents = new AbortController();
    const { signal } = pointerEvents;
    const clearPointer = () => {
      instance.current.x = null;
      instance.current.y = null;
    };
    window.addEventListener(
      "pointermove",
      event => {
        if (event.pointerType === "touch") return;
        const rect = instance.canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        instance.current.x =
          ((event.clientX - rect.left) * instance.canvas.width) / rect.width;
        instance.current.y =
          ((event.clientY - rect.top) * instance.canvas.height) / rect.height;
      },
      { passive: true, signal }
    );
    window.addEventListener(
      "pointerout",
      event => {
        // Moving between links and other page elements is not leaving the page.
        if (!event.relatedTarget) clearPointer();
      },
      { passive: true, signal }
    );
    window.addEventListener("blur", clearPointer, { signal });
    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.hidden) clearPointer();
      },
      { signal }
    );
    canvasWindow.canvasNestPointerCleanup = () => pointerEvents.abort();
  }

  function initCanvasNest() {
    canvasWindow.canvasNestMediaCleanup?.();
    destroyCanvasNest();

    const mediaQuery = window.matchMedia(disabledMediaQuery);
    const handleMediaChange = () => syncCanvasNest(mediaQuery);

    mediaQuery.addEventListener("change", handleMediaChange);
    canvasWindow.canvasNestMediaCleanup = () => {
      mediaQuery.removeEventListener("change", handleMediaChange);
      canvasWindow.canvasNestMediaCleanup = undefined;
    };

    syncCanvasNest(mediaQuery);
  }

  function cleanupCanvasNest() {
    canvasWindow.canvasNestMediaCleanup?.();
    destroyCanvasNest();
  }

  document.addEventListener("astro:page-load", initCanvasNest);
  document.addEventListener("astro:before-swap", cleanupCanvasNest);
  initCanvasNest();
</script>

<style>
  .canvas-nest-background {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .canvas-nest-background :global(canvas) {
    pointer-events: none !important;
  }

  @media (max-width: 768px), (prefers-reduced-motion: reduce) {
    .canvas-nest-background {
      display: none;
    }
  }
</style>
